# Nomus Dashboard — multi-stage Dockerfile
# Build context: repository root.
#
#   docker build -f Dockerfile.dashboard -t nomus-dashboard .
#
# Serves the static React build with an unprivileged Nginx on port 8080. The
# dashboard calls the API on the same origin (/api/v1), and
# infra/nginx-dashboard.conf.template proxies /api to the engine at
# NOMUS_ENGINE_UPSTREAM (default engine:3100, the Compose service), so no API
# URL is baked into the bundle.
# Published as ghcr.io/babbguy/nomus-dashboard (see .github/workflows/publish.yml).

# ─── Stage 1: Install + Build ─────────────────────────────────────────────
# The output is static files, so this stage runs on the build host's platform
# even when building for another one.
FROM --platform=$BUILDPLATFORM node:22-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY dashboard/package.json dashboard/

RUN npm ci --workspace=dashboard --workspace=packages/shared --include-workspace-root

COPY tsconfig.base.json ./
COPY packages/shared/ packages/shared/
COPY dashboard/ dashboard/

RUN npm run build -w packages/shared && \
    npm run build -w dashboard

# ─── Stage 2: Serve with Nginx (runs as the unprivileged nginx user) ──────
FROM nginxinc/nginx-unprivileged:1.30-alpine AS runtime

COPY --from=build /app/dashboard/dist /usr/share/nginx/html
COPY infra/nginx-dashboard.conf.template /etc/nginx/templates/default.conf.template

# The image's entrypoint renders /etc/nginx/templates/*.template into
# /etc/nginx/conf.d at start, substituting only the NOMUS_* variables.
ENV NOMUS_ENGINE_UPSTREAM=engine:3100 \
    NGINX_ENVSUBST_FILTER=^NOMUS_

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/health"]

ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="Nomus Dashboard" \
      org.opencontainers.image.description="Nomus web dashboard (Nginx serving the React build and proxying the engine API)" \
      org.opencontainers.image.source="https://github.com/babbguy/Nomus" \
      org.opencontainers.image.url="https://github.com/babbguy/Nomus" \
      org.opencontainers.image.documentation="https://github.com/babbguy/Nomus/blob/main/docs/admin-guide/deployment.md" \
      org.opencontainers.image.licenses="FSL-1.1-ALv2" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
