{
  "name": "nomus-scan",
  "version": "1.1.0",
  "description": "Nomus scanner: find AI SDK usage and AI capabilities in a codebase and check them against the regulations that apply, from the command line or as a library",
  "keywords": [
    "nomus",
    "ai",
    "ai-compliance",
    "ai-governance",
    "regulatory",
    "eu-ai-act",
    "compliance",
    "sarif",
    "scanner",
    "cli"
  ],
  "license": "FSL-1.1-ALv2",
  "author": "babbguy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babbguy/Nomus.git",
    "directory": "packages/scanner"
  },
  "homepage": "https://github.com/babbguy/Nomus/tree/main/packages/scanner#readme",
  "bugs": {
    "url": "https://github.com/babbguy/Nomus/issues"
  },
  "type": "module",
  "main": "dist/scan.js",
  "types": "./dist/scan.d.ts",
  "exports": {
    ".": {
      "import": "./dist/scan.js",
      "types": "./dist/scan.d.ts"
    },
    "./sarif": {
      "import": "./dist/output/sarif.js",
      "types": "./dist/output/sarif.d.ts"
    },
    "./detect": {
      "import": "./dist/detect/imports.js",
      "types": "./dist/detect/imports.d.ts"
    },
    "./capabilities": {
      "import": "./dist/detect/capabilities.js",
      "types": "./dist/detect/capabilities.d.ts"
    },
    "./reporter": {
      "import": "./dist/output/reporter.js",
      "types": "./dist/output/reporter.d.ts"
    },
    "./config": {
      "import": "./dist/config/loader.js",
      "types": "./dist/config/loader.d.ts"
    },
    "./detector": {
      "import": "./dist/detect/detector.js",
      "types": "./dist/detect/detector.d.ts"
    },
    "./corporate": {
      "import": "./dist/corporate/index.js",
      "types": "./dist/corporate/index.d.ts"
    }
  },
  "bin": {
    "nomus-scan": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "glob": "^14.0.3",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
