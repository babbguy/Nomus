# Build context for Dockerfile and Dockerfile.dashboard (repository root).
# Each Dockerfile copies only what it needs; this keeps the context small and
# keeps local state and secrets out of it.

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/dist
**/*.tsbuildinfo
**/coverage
**/*.vsix

# Version control, CI and editor state
.git
.github
.claude
**/CLAUDE.md
.vscode
.idea

# Local data, logs and secrets
data
**/data/*.db*
**/*.log
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
infra/certbot

# Not used by either image
docs
e2e
packages/github-action
packages/mcp-server
packages/vscode-extension
