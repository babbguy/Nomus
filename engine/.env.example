# Nomus Engine — Environment Variables
# Copy this file to engine/.env and fill in real values. The engine reads .env from its
# working directory (engine/ when started through the npm scripts).
#
# NOMUS_ENV is development, staging or production. The production startup checks
# (secret lengths, NOMUS_CORS_ORIGIN, a non-placeholder admin email) also apply whenever
# NODE_ENV=production, which the Docker image sets.

NOMUS_ENV=development
NOMUS_PORT=3100
NOMUS_LOG_LEVEL=info
NOMUS_LOG_FORMAT=text
NOMUS_DB_PATH=./data/nomus.db

# Security — generate strong random values for production
# NOMUS_SIGNING_KEY_SECRET: 32+ characters. NOMUS_ADMIN_BOOTSTRAP_KEY: 10+ characters.
NOMUS_SIGNING_KEY_SECRET=REPLACE_ME_WITH_32_CHAR_SECRET!!
NOMUS_ADMIN_BOOTSTRAP_KEY=REPLACE_ME_WITH_BOOTSTRAP_KEY

# LLM — Anthropic
NOMUS_ANTHROPIC_API_KEY=sk-ant-REPLACE_ME_WITH_REAL_KEY
NOMUS_LLM_CLASSIFIER_PROVIDER=anthropic
NOMUS_LLM_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
NOMUS_LLM_TRANSLATOR_PROVIDER=anthropic
NOMUS_LLM_TRANSLATOR_MODEL=claude-haiku-4-5-20251001

# LLM — Google (optional)
# NOMUS_GOOGLE_AI_KEY=
# NOMUS_LLM_FALLBACK_PROVIDER=none

# LLM — OpenAI (optional)
# NOMUS_OPENAI_API_KEY=

# Portal Admin — production refuses to start if this is left as a shipped
# placeholder or a public contact address. Use a real mailbox you control.
NOMUS_ADMIN_EMAIL=REPLACE_ME@yourdomain.com
# NOMUS_ADMIN_PASSWORD: 12+ characters. (Do not put comments on the same line as a value:
# the .env loader does not strip them.)
NOMUS_ADMIN_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD

# CORS — the single origin the dashboard is served from. It is also the base of
# password-reset links and of the Google/GitHub OAuth redirect URLs
# (<origin>/api/v1/auth/oauth/google/callback, <origin>/api/v1/auth/github/callback).
# Use http://localhost:5173 with `npm run dev:dashboard`, http://localhost:8080 with
# docker compose, and your public https URL in production (required there).
NOMUS_CORS_ORIGIN=http://localhost:5173

# Request limits (all optional; defaults shown)
# NOMUS_RATE_LIMIT_RPM=600
# NOMUS_MAX_API_KEYS_PER_ORG=100
# NOMUS_MAX_SSE_CONNECTIONS_PER_ORG=100

# Headless browser fetch — ACCESS-ESCALATION tier (default OFF).
# When 'true', sources that block bots or render their document via JavaScript
# (and any source flagged needsHeadless, e.g. the California AB 2013 JSF/XHTML
# bill viewer) are escalated to a headless Chromium capture BEFORE being held
# for manual upload. Captures are stored with provenance 'rendered' (promotable,
# but never presented as byte-exact — the JS-mutated DOM is not the raw body).
#
# DEPLOY WEIGHT — READ THIS: enabling headless requires the Chromium browser
# binary on the host, installed with:
#     npx playwright install chromium
# That download is ~150MB. It is NOT pulled by `npm ci` and is NOT needed to
# build the engine or run the test suite — the engine runs fine with headless
# left OFF (sources simply escalate straight to manual upload). When headless is
# ON but the browser is absent, the source escalates to manual upload as well.
# NOMUS_HEADLESS_ENABLED=false
#
# Optional proxy for the headless browser context (residential/rotating egress
# for stubborn bot walls). Passed straight to chromium.launch({ proxy }).
# NOMUS_HEADLESS_PROXY=http://user:pass@host:port

# Modus Integration (optional)
# NOMUS_MODUS_API_URL=
# NOMUS_MODUS_API_KEY=

# Outbound webhook signing
# Nomus signs outbound webhooks twice during the consumer migration window:
#   X-Nomus-Signature     legacy: HMAC-SHA256(secret, body) hex
#   X-Nomus-Signature-V2  new:    "sha256=" + HMAC-SHA256(secret, "<timestamp>.<body>") hex
# The X-Nomus-Timestamp header is bound into the V2 signature, closing the
# replay-with-rewritten-timestamp gap. Keep 'true' (default) until every
# consumer (Modus and any custom subscribers) verifies V2, then set 'false'
# to stop emitting the legacy body-only signature.
# NOMUS_WEBHOOK_LEGACY_SIGNATURE=true

# Error tracking (Sentry). Leave UNSET (default) for a true no-op: the SDK is
# never initialized, nothing leaves the process — the right choice for
# self-hosted, telemetry-sensitive deployments. When set, ONLY route/status/
# error metadata is transmitted; request bodies, query strings, cookies,
# headers, user identity, and all regulatory/org data are stripped before send.
# NOMUS_SENTRY_DSN=
# NOMUS_SENTRY_TRACES_SAMPLE_RATE=0

# Scheduling
NOMUS_SCRAPE_CRON=0 2 * * *

# Raw snapshot retention (days). Leave UNSET (default) to keep raw snapshots
# FOREVER — they are the byte-exact provenance record behind Nomus's
# source-exact regulation guarantee (raw_bytes_hash), and deleting them
# destroys the ability to prove stored regulations match the publisher
# byte-for-byte. If you must bound disk usage, set a positive integer:
# snapshots older than N days are purged weekly, but every source always
# keeps its most recent snapshot.
# NOMUS_RAW_SNAPSHOT_RETENTION_DAYS=

# Scout
NOMUS_SCOUT_ENABLED=true
NOMUS_SCOUT_CRON=0 */6 * * *

# OAuth — Google (optional)
# NOMUS_GOOGLE_CLIENT_ID=
# NOMUS_GOOGLE_CLIENT_SECRET=

# Email — Resend (optional)
# NOMUS_RESEND_API_KEY=
# NOMUS_FROM_EMAIL=Nomus <noreply@example.com>

# Push Notifications — ntfy (optional)
# NOMUS_NTFY_URL=
# NOMUS_NTFY_TOPIC=
# NOMUS_NTFY_TOKEN=

# Slack Webhook (optional)
# NOMUS_SLACK_WEBHOOK_URL=

# GitHub App (optional)
# NOMUS_GITHUB_APP_ID=
# NOMUS_GITHUB_APP_PRIVATE_KEY=
# NOMUS_GITHUB_WEBHOOK_SECRET=
# NOMUS_GITHUB_CLIENT_ID=
# NOMUS_GITHUB_CLIENT_SECRET=

# Scout v2 — legislative tracking (optional)
# Congress.gov API key — DEMO_KEY is rate-limited (5 req/hr), get a real key
# from https://api.congress.gov/sign-up to scrape federal bills reliably
# NOMUS_CONGRESS_GOV_API_KEY=DEMO_KEY
# NOMUS_SCOUT_AUTO_PROMOTE_THRESHOLD=0.85
# NOMUS_SCOUT_KEYWORD_THRESHOLD=0.15
# NOMUS_SCOUT_LLM_BATCH_SIZE=10

# Optional on-chain anchoring of the rule-corpus state hash (read by packages/chain;
# all three must be set, otherwise the daily anchor job is skipped)
# NOMUS_POLYGON_RPC_URL=
# NOMUS_POLYGON_PRIVATE_KEY=
# NOMUS_POLYGON_CONTRACT=

# Base URL the engine uses to call its own API from background tasks (GitHub App scans).
# Defaults to http://127.0.0.1:<NOMUS_PORT>.
# NOMUS_INTERNAL_API_URL=

# Pipeline gating
# NOMUS_REQUIRE_RULE_APPROVAL=false

# Fallback alert recipient, used only if the recipient list saved in the dashboard
# (Admin, Notifications) cannot be read; defaults to NOMUS_ADMIN_EMAIL. Sending needs
# NOMUS_RESEND_API_KEY.
# NOMUS_NOTIFICATION_EMAIL=

